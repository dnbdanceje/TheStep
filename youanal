def parse_iso_duration(iso):
    """PT1H2M3S → секунды"""
    m = re.match(r"PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?", iso or "")
    if not m:
        return 0
    h = int(m.group(1) or 0)
    m_ = int(m.group(2) or 0)
    s = int(m.group(3) or 0)
    return h * 3600 + m_ * 60 + s


def format_published(published_iso):
    """Точное время публикации: 14.09.2026 18:32"""
    if not published_iso:
        return "—"
    try:
        pub_dt = dt.datetime.fromisoformat(published_iso.replace("Z", "+00:00")).replace(tzinfo=None)
        return pub_dt.strftime("%d.%m.%Y %H:%M")
    except Exception:
        return published_iso


def get_avg_view_durations(ya, video_ids, start, end):
    """Запрашивает averageViewDuration отдельно для каждого видео"""
    avg_durations = {}
    for vid in video_ids:
        try:
            r = analytics_query(
                ya, ids="channel==MINE",
                startDate=start.isoformat(), endDate=end.isoformat(),
                metrics="averageViewDuration",
                filters=f"video=={vid}",
            )
            if r.get("rows"):
                avg_durations[vid] = r["rows"][0][0]
            else:
                avg_durations[vid] = 0
        except Exception as e:
            print(f"  ⚠️ averageViewDuration для {vid}: {e}")
            avg_durations[vid] = 0
    return avg_durations


