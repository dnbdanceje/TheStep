def get_trending_videos(ya, yt, limit=10):
    today = dt.date.today()
    curr_end = today - dt.timedelta(days=1)
    curr_start = curr_end - dt.timedelta(days=6)
    prev_end = curr_start - dt.timedelta(days=1)
    prev_start = prev_end - dt.timedelta(days=6)

    def _query(start, end):
        r = analytics_query(
            ya, ids="channel==MINE",
            startDate=start.isoformat(), endDate=end.isoformat(),
            metrics="views", dimensions="video", sort="-views", maxResults=200,
        )
        return {row[0]: row[1] for row in r.get("rows", [])}

    curr = _query(curr_start, curr_end)
    prev = _query(prev_start, prev_end)

    video_ids = set(curr) | set(prev)
    rows = []
    for vid in video_ids:
        c = curr.get(vid, 0)
        p = prev.get(vid, 0)
        delta = c - p
        growth = round((c - p) / p * 100, 2) if p > 0 else (100.0 if c > 0 else 0.0)
        rows.append([vid, c, p, delta, growth])

    rows.sort(key=lambda x: x[3], reverse=True)
    rows = [r for r in rows if r[3] > 0][:limit]

    video_ids_list = [r[0] for r in rows]
    avg_durations = get_avg_view_durations(ya, video_ids_list, curr_start, curr_end)

    details = get_video_details(yt, video_ids_list)
    out = []
    for vid, curr_w, prev_w, delta, growth in rows:
        d = details.get(vid, {})
        content_type = "Shorts" if d.get("is_short") else "Видео"
        avg_dur = avg_durations.get(vid, 0)
        out.append([
            vid,
            d.get("title", "—"),
            content_type,
            curr_w, prev_w, delta, growth,
            round(avg_dur / 60, 2),
            format_published(d.get("published", "")),
        ])

    return out, [
        "video_id", "title", "Тип",
        "Просм. тек. нед.", "Просм. прош. нед.", "Прирост", "Рост %",
        "Ср. просмотр (мин)", "Дата публикации"
    ]


