def get_my_channel(yt):
    resp = yt.channels().list(part="id,snippet,statistics", mine=True).execute()
    items = resp.get("items", [])
    if not items:
        raise RuntimeError("Канал не найден.")
    item = items[0]
    return {
        "id": item["id"],
        "title": item["snippet"]["title"],
        "published_at": item["snippet"].get("publishedAt"),
        "subscribers": item.get("statistics", {}).get("subscriberCount"),
        "videos": item.get("statistics", {}).get("videoCount"),
        "views": item.get("statistics", {}).get("viewCount"),
        "thumbnail": item["snippet"].get("thumbnails", {}).get("default", {}).get("url"),
    }


def analytics_query(ya, **kwargs):
    return ya.reports().query(**kwargs).execute()


def get_video_details(yt, video_ids):
    """Возвращает словарь {video_id: {'title', 'published', 'duration', 'is_short'}}"""
    details = {}
    for i in range(0, len(video_ids), 50):
        chunk = video_ids[i:i+50]
        if not chunk:
            continue
        v = yt.videos().list(
            part="snippet,contentDetails",
            id=",".join(chunk)
        ).execute()
        for item in v.get("items", []):
            duration_iso = item["contentDetails"].get("duration", "PT0S")
            seconds = parse_iso_duration(duration_iso)
            details[item["id"]] = {
                "title": item["snippet"]["title"],
                "published": item["snippet"].get("publishedAt", ""),
                "duration": seconds,
                "is_short": seconds <= 60,
            }
    return details


