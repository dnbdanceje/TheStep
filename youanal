def fmt(n):
    try:
        return f"{int(n):,}".replace(",", " ")
    except:
        return str(n)


def table_html(rows, headers):
    html = '<table><thead><tr>'
    for h in headers:
        html += f'<th>{h}</th>'
    html += '</tr></thead><tbody>'
    for row in rows:
        html += '<tr>'
        for i, cell in enumerate(row):
            if isinstance(cell, (int, float)):
                if 'рост' in headers[i].lower() and '%' in headers[i]:
                    cls = 'positive' if cell >= 0 else 'negative'
                    html += f'<td class="{cls}">{cell}%</td>'
                elif 'прирост' in headers[i].lower():
                    cls = 'positive' if cell >= 0 else 'negative'
                    sign = '+' if cell >= 0 else ''
                    html += f'<td class="{cls}">{sign}{fmt(cell)}</td>'
                else:
                    html += f'<td>{fmt(cell)}</td>'
            elif str(cell) == "Shorts":
                html += f'<td><span style="background:#ff0000;color:#fff;padding:2px 8px;border-radius:10px;font-size:12px;">Shorts</span></td>'
            elif str(cell) == "Видео":
                html += f'<td><span style="background:#667eea;color:#fff;padding:2px 8px;border-radius:10px;font-size:12px;">Видео</span></td>'
            else:
                html += f'<td>{cell}</td>'
        html += '</tr>'
    html += '</tbody></table>'
    return html


